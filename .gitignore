# Build artifacts (all root-level CMake build trees)
/build*/

# ROM files (copyrighted)
*.smc
*.sfc
*.rom

# Third-party ROM patches (not this project's work -- reference-only,
# never redistributed from this repo). The Sylt map patch is the one
# exception: its author gave written permission, and it carries only
# their own map plus the pointer and seed bytes to hook it up -- no ROM
# content. See sylt_graphics/PROVENANCE.md.
*.ips
!sylt_graphics/sylt.ips

# Active recompiler output -- generated locally per-developer
src/gen/

# Extracted graphics/text (tools/extract_graphics.py output) -- derived
# from the copyrighted ROM, generated locally per-developer
/extracted_assets/

# Save files
saves/
*.sav
*.srm
*.srm.bak
*.srm.tmp
*.srm.population*
*.srm.world*

# IDE
.vs/
*.vcxproj.user

# OS
Thumbs.db
.DS_Store

# Python caches
__pycache__/
*.pyc

# Local-only config overrides (per-developer, applied after config.ini)
config.local.ini
sc-video.ini
sc-video.ini.tmp
rom.cfg
# Launcher state (src/sc_launcher.c, recomp-ui)
sc-settings.ini
sc-settings.ini.tmp
keybinds.ini
imgui.ini

# Boot traces / triage scratch (generated at runtime)
boot_trace*.txt
_*

# On-demand WRAM snapshots (F4 hotkey) and other ad-hoc runtime dumps --
# generated locally per-debugging-session, derived from the copyrighted
# ROM's runtime state
wram_snapshot.bin
*.wram

# Save states (numbered-slot hotkeys / --load-state) -- full emulator
# snapshots derived from the copyrighted ROM's runtime state, generated
# locally per-debugging-session
savestate_*.bin
menu_preview.ppm

# Local visual reference from the design of the project logo. The game's
# official wordmark is its publisher's artwork, so it stays local
# and is deliberately not distributed with this repository -- same
# reasoning as the ROM and the save states above.
logo.png

# Third-party reference tool (Brad Smith, rainwarrior.ca) -- no stated
# licence, so kept local and not redistributed. Findings are recorded in
# docs/REFERENCE_map_format.md instead.
*_map.lua

# Recorded-session artifacts. Both are derived from the copyrighted ROM --
# coverage.bin is a map of which ROM addresses executed, session_sram.bin is
# the game's own save data -- so they stay local, same reasoning as the ROM
# and save states above. What they were USED for is committed (the cfg
# entry points in recomp/, and the measurements in README.md); the captures
# themselves are not.
coverage*.bin
wram_map*.bin
wmap_*.bin
# snesrecomp tier-2 discovery captures, written by AOT runs
tier2_*.jsonl
session_sram.bin
*_sram.bin

# SC_MX_BITMAP captures -- the same execution map as coverage*.bin, split by
# the live (m,x) width flags. Same reasoning: derived from the copyrighted
# ROM, so the capture stays local while what it established is committed
# (the exit_mx_at/entry_mx_at directives in recomp/ and the numbers in
# README.md). Regenerate with SC_MX_BITMAP=<path> on any run.
mx_*.bin

# sylt_graphics/ is committed: the Sylt map is used with the written permission
# of its author, and the card artwork is the project's own. See
# sylt_graphics/PROVENANCE.md. Two things stay out:
#
#   The "Rio on its own Bank" patch embeds 7605 bytes that are byte-identical
#   to Rio's map in the ROM (verified: it decompresses to the same 10068 bytes).
#   That is copyrighted ROM data, which no third-party permission covers, and
#   this host does not need it -- Rio is never relocated. See docs/ROM_MAP.md.
#
#   *_check.png are the check renders tools/make_sylt_card.py writes.
sylt_graphics/*Rio on its own Bank.ips
sylt_graphics/*_check.png

# Screen-packet patches (tools/text_tool.py packets). Built from a donor
# ROM and carrying its artwork verbatim, so they are ROM-derived and stay
# out, exactly like the message and briefing blobs.
*.scpk

# Translation blobs (tools/text_tool.py import/pack). Same reason: the
# words and glyphs are lifted out of a donor ROM.
translation_*.bin

# Building-label sheets (tools/text_tool.py labels). The exported image IS
# the ROM's artwork, so it is ROM-derived exactly like the blobs above --
# a translator's edited version is theirs to keep, not this repo's.
labels_*.png

# Release packages (tools/package_release.py)
/dist/

# User-provided restored soundtrack, imported locally and never committed.
/music/restored/
*.pcm
